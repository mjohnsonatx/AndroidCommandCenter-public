<Window x:Class="AndroidCommandCenter.CiCdSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CI/CD Settings"
        Height="580" Width="620"
        Background="#1e1e2e"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8,16,12">
            <Button Content="Save"   Style="{StaticResource CmdButton}"
                    Click="Save_Click"   Background="#1e66f5" Foreground="White" FontWeight="Bold"
                    Padding="20,6" />
            <Button Content="Cancel" Style="{StaticResource CmdButton}"
                    Click="Cancel_Click" Padding="20,6" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>

                <!-- ── SIGNING ──────────────────── -->
                <TextBlock Text="SIGNING CONFIGURATION" FontWeight="Bold"
                           Foreground="#89b4fa" FontSize="14" Margin="0,0,0,8" />

                <TextBlock Text="Keystore file (.jks):" Foreground="#a6adc8" Margin="0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="KeystoreBox" Style="{StaticResource DarkTextBox}" />
                    <Button  Grid.Column="1" Content="Browse"
                             Style="{StaticResource CmdButton}" Click="BrowseKeystore_Click" />
                </Grid>

                <TextBlock Text="Keystore password:" Foreground="#a6adc8" Margin="0,4" />
                <PasswordBox x:Name="StorePassBox"
                             Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" Padding="6,4" FontSize="13" />

                <TextBlock Text="Key alias:" Foreground="#a6adc8" Margin="0,4" />
                <TextBox x:Name="KeyAliasBox" Style="{StaticResource DarkTextBox}" />

                <TextBlock Text="Key password:" Foreground="#a6adc8" Margin="0,4" />
                <PasswordBox x:Name="KeyPassBox"
                             Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" Padding="6,4" FontSize="13" />

                <!-- ── FIREBASE ─────────────────── -->
                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,16,0,8" />
                <TextBlock Text="FIREBASE APP DISTRIBUTION" FontWeight="Bold"
                           Foreground="#a6e3a1" FontSize="14" Margin="0,0,0,8" />

                <TextBlock Text="Firebase CLI command or path:" Foreground="#a6adc8" Margin="0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FirebaseCliBox" Style="{StaticResource DarkTextBox}" />
                    <Button  Grid.Column="1" Content="Test"
                             Style="{StaticResource CmdButton}" Click="TestFirebase_Click"
                             ToolTip="Verify Firebase CLI is installed" />
                </Grid>

                <TextBlock Text="Firebase App ID (e.g. 1:123:android:abc):" Foreground="#a6adc8" Margin="0,4" />
                <TextBox x:Name="AppIdBox" Style="{StaticResource DarkTextBox}" />

                <TextBlock Text="Distribution groups (comma-separated):" Foreground="#a6adc8" Margin="0,4" />
                <TextBox x:Name="GroupsBox" Style="{StaticResource DarkTextBox}" />

                <TextBlock Text="CI Token (from 'firebase login:ci'):" Foreground="#a6adc8" Margin="0,4" />
                <PasswordBox x:Name="TokenBox"
                             Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" Padding="6,4" FontSize="13" />

                <TextBlock Text="OR Service Account JSON file:" Foreground="#a6adc8" Margin="0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServiceAccountBox" Style="{StaticResource DarkTextBox}" />
                    <Button  Grid.Column="1" Content="Browse"
                             Style="{StaticResource CmdButton}" Click="BrowseServiceAccount_Click" />
                </Grid>

                <TextBlock Text="Release notes (default text for deploys):" Foreground="#a6adc8" Margin="0,4" />
                <TextBox x:Name="ReleaseNotesBox" Style="{StaticResource DarkTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                         VerticalContentAlignment="Top" />

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>