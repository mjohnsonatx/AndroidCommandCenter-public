<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Neutral slate with blue/teal accents. -->
    <Color x:Key="Crust">#0b1118</Color>
    <Color x:Key="Mantle">#111a24</Color>
    <Color x:Key="Base">#17212c</Color>
    <Color x:Key="Surface0">#223043</Color>
    <Color x:Key="Surface1">#31435a</Color>
    <Color x:Key="Surface2">#405773</Color>
    <Color x:Key="Overlay0">#8292a6</Color>
    <Color x:Key="Subtext0">#b6c2d0</Color>
    <Color x:Key="Text">#e7edf4</Color>
    <Color x:Key="Blue">#62b6ff</Color>
    <Color x:Key="Green">#68d391</Color>
    <Color x:Key="Yellow">#f2cc8f</Color>
    <Color x:Key="Peach">#f4a261</Color>
    <Color x:Key="Red">#ff7a90</Color>
    <Color x:Key="Mauve">#52d2c7</Color>

    <SolidColorBrush x:Key="CrustBrush"    Color="{StaticResource Crust}"/>
    <SolidColorBrush x:Key="MantleBrush"   Color="{StaticResource Mantle}"/>
    <SolidColorBrush x:Key="BaseBrush"     Color="{StaticResource Base}"/>
    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}"/>
    <SolidColorBrush x:Key="Overlay0Brush" Color="{StaticResource Overlay0}"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="{StaticResource Subtext0}"/>
    <SolidColorBrush x:Key="TextBrush"     Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="BlueBrush"     Color="{StaticResource Blue}"/>
    <SolidColorBrush x:Key="GreenBrush"    Color="{StaticResource Green}"/>
    <SolidColorBrush x:Key="YellowBrush"   Color="{StaticResource Yellow}"/>
    <SolidColorBrush x:Key="PeachBrush"    Color="{StaticResource Peach}"/>
    <SolidColorBrush x:Key="RedBrush"      Color="{StaticResource Red}"/>
    <SolidColorBrush x:Key="MauveBrush"    Color="{StaticResource Mauve}"/>

    <FontFamily x:Key="MonoFont">JetBrains Mono, Fira Code, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
  </Styles.Resources>

  <!-- ═══ WINDOW ═══ -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BaseBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- ═══ TEXT ═══ -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
    <Setter Property="Margin" Value="0,8,0,4"/>
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.toolbar-label">
    <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>
  <Style Selector="TextBlock.metric-label">
    <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>
  <Style Selector="TextBlock.metric-value">
    <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="7,0,0,0"/>
  </Style>
  <Style Selector="TextBlock.form-label">
    <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
  </Style>
  <!-- Inline field error — hidden until there's text -->
  <Style Selector="TextBlock.field-error">
    <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="2,2,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.ctx-key">
    <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
  </Style>
  <Style Selector="TextBlock.ctx-value">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
  </Style>

  <!-- ═══ BUTTONS ═══ -->
  <Style Selector="Button.cmd">
    <Setter Property="Margin" Value="4"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.cmd.compact">
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style Selector="Button.cmd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
  </Style>
  <Style Selector="Button.cmd:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
  </Style>
  <Style Selector="Button.cmd:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.45"/>
  </Style>

  <Style Selector="Button.cmd.primary">
    <Setter Property="Background" Value="#1976d2"/>
    <Setter Property="BorderBrush" Value="#1976d2"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="20,6"/>
  </Style>
  <Style Selector="Button.cmd.success">
    <Setter Property="Background" Value="#2f9e65"/>
    <Setter Property="BorderBrush" Value="#2f9e65"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="20,6"/>
  </Style>
  <Style Selector="Button.cmd.danger">
    <Setter Property="Background" Value="#d94c66"/>
    <Setter Property="BorderBrush" Value="#d94c66"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="Button.cmd.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.cmd.success:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.cmd.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.85"/>
  </Style>

  <!-- Sidebar nav -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="24,6,8,6"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
  </Style>
  <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="Button.nav.accent"><Setter Property="Foreground" Value="{StaticResource BlueBrush}"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="Button.nav.danger"><Setter Property="Foreground" Value="{StaticResource RedBrush}"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="Button.nav.green"><Setter Property="Foreground" Value="{StaticResource GreenBrush}"/><Setter Property="FontWeight" Value="Bold"/></Style>

  <!-- ═══ INPUTS ═══ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Surface2Brush}"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
  </Style>
  <!-- Validation state — applied by FieldValidator -->
  <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement,
                   TextBox.invalid:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBox.log">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{StaticResource CrustBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0,3"/>
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- ═══ PROGRESS BAR (dashboard meters) ═══ -->
  <Style Selector="ProgressBar.dash">
    <Setter Property="Height" Value="18"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>

  <!-- ═══ EXPANDER (sidebar groups) ═══ -->
  <Style Selector="Expander.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Expander.nav /template/ ToggleButton#PART_toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Expander.nav /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- ═══ TABS ═══ -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="{StaticResource BaseBrush}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
  </Style>

  <!-- ═══ DATAGRID ═══ -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{StaticResource CrustBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RowBackground" Value="{StaticResource BaseBrush}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
    <Setter Property="CanUserReorderColumns" Value="False"/>
    <Setter Property="MinColumnWidth" Value="40"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource Subtext0Brush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style Selector="DataGridRow:nth-child(2n)">
    <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource Surface0Brush}"/>
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{StaticResource Surface1Brush}"/>
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="26"/>
  </Style>
  <!-- Result column colouring (set Classes in code on the row) -->
  <Style Selector="DataGridRow.pass DataGridCell.result"><Setter Property="Foreground" Value="{StaticResource GreenBrush}"/></Style>
  <Style Selector="DataGridRow.fail DataGridCell.result"><Setter Property="Foreground" Value="{StaticResource RedBrush}"/></Style>

  <!-- ═══ MISC ═══ -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Margin" Value="0,8"/>
    <Setter Property="Height" Value="1"/>
  </Style>
  <Style Selector="Border.hr">
    <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Margin" Value="0,14,0,8"/>
  </Style>
  <Style Selector="Border.ctx-banner">
    <Setter Property="Background" Value="{StaticResource CrustBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>
  <Style Selector="Border.card.panel-card">
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.empty-banner">
    <Setter Property="Background" Value="#14283a"/>
    <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="16,12"/>
  </Style>
  <Style Selector="Border.status-pill">
    <Setter Property="Background" Value="{StaticResource CrustBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="11,5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource Surface0Brush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ═══ TOASTS ═══ -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{StaticResource MantleBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}"/>
    <Setter Property="BorderThickness" Value="1,1,1,1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Width" Value="380"/>
    <Setter Property="BoxShadow" Value="0 4 16 0 #80000000"/>
  </Style>
  <Style Selector="Border.toast-accent">
    <Setter Property="Width" Value="5"/>
    <Setter Property="CornerRadius" Value="6,0,0,6"/>
  </Style>
  <Style Selector="Button.toast-close">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Overlay0Brush}"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.toast-link">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!-- ═══ BUSY OVERLAY ═══ -->
  <Style Selector="Border.busy-veil">
    <Setter Property="Background" Value="#66000000"/>
    <Setter Property="IsHitTestVisible" Value="True"/>
  </Style>
</Styles>
