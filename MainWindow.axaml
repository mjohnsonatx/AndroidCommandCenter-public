<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AndroidCommandCenter.UI"
        x:Class="AndroidCommandCenter.MainWindow"
        Title="Android Command Center" Width="1380" Height="900"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <!-- Panel, not Grid, so the toast host floats above everything -->
  <Panel>
    <DockPanel>
      <!-- ═══ TOP BAR ═══ -->
      <Border DockPanel.Dock="Top" Background="{StaticResource MantleBrush}" Padding="12,8">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                <TextBlock Text="Project" Classes="toolbar-label"/>
                <ComboBox x:Name="ProjectCombo" Width="260"
                          SelectionChanged="ProjectCombo_SelectionChanged"/>
                <Button Classes="cmd compact" Content="+" Width="30" Click="AddProject_Click"
                        ToolTip.Tip="Add project folder"/>
                <Button Classes="cmd compact" Content="−" Width="30" Click="RemoveProject_Click"
                        ToolTip.Tip="Remove from list"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                <TextBlock Text="Variant" Classes="toolbar-label"/>
                <ComboBox x:Name="VariantCombo" Width="180"
                          SelectionChanged="VariantCombo_SelectionChanged"/>
                <Button Classes="cmd compact" Content="Detect" Click="DetectVariants_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="AVD" Classes="toolbar-label"/>
                <ComboBox x:Name="AvdCombo" Width="180"
                          SelectionChanged="AvdCombo_SelectionChanged"/>
                <Button Classes="cmd compact" Content="↻" Width="30" Click="RefreshAvds_Click"/>
              </StackPanel>
            </WrapPanel>
            <Border Grid.Column="1" Classes="status-pill">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ProgressBar x:Name="BusySpinner" IsIndeterminate="True" IsVisible="False"
                             Width="54" Height="4" VerticalAlignment="Center"/>
                <TextBlock Text="STATUS" Classes="toolbar-label" Margin="0"/>
                <TextBlock x:Name="StatusLabel" Text="Idle" Foreground="{StaticResource GreenBrush}"
                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="Auto,110,44,18,Auto,130,92,22,Auto,Auto,24,Auto,210,*">
            <TextBlock Text="CPU" Classes="metric-label"/>
            <ProgressBar Grid.Column="1" x:Name="CpuBar" Classes="dash" Maximum="100" Foreground="{StaticResource BlueBrush}"/>
            <TextBlock Grid.Column="2" x:Name="CpuLabel" Text="—" Classes="metric-value"/>
            <TextBlock Grid.Column="4" Text="RAM" Classes="metric-label"/>
            <ProgressBar Grid.Column="5" x:Name="MemBar" Classes="dash" Maximum="100" Foreground="{StaticResource GreenBrush}"/>
            <TextBlock Grid.Column="6" x:Name="MemLabel" Text="—" Classes="metric-value"/>
            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Daemons" Classes="metric-label"/>
              <TextBlock x:Name="DaemonLabel" Text="0" Foreground="{StaticResource YellowBrush}" FontWeight="Bold"
                         FontSize="13" Margin="5,0,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="9" Text="" Width="16"/>
            <TextBlock Grid.Column="11" Text="Target" Classes="metric-label"/>
            <ComboBox Grid.Column="12" x:Name="DeviceCombo" SelectionChanged="DeviceCombo_SelectionChanged"/>
            <StackPanel Grid.Column="13" Orientation="Horizontal" Margin="18,0,0,0">
              <TextBlock Text="Connected" Classes="metric-label"/>
              <TextBlock x:Name="DeviceListLabel" Text="scanning…" FontSize="13"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="7,0,0,0"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ CONTEXT BANNER ═══ -->
      <Border DockPanel.Dock="Top" Classes="ctx-banner">
        <WrapPanel>
          <TextBlock Classes="ctx-key" Text="Working on:"/>
          <TextBlock x:Name="CtxProjectLabel" Classes="ctx-value" Text="(no project)"/>
          <TextBlock Classes="ctx-key" Text="Repo:"/>
          <TextBlock x:Name="CtxRepoLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Branch:"/>
          <TextBlock x:Name="CtxBranchLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Signing:"/>
          <TextBlock x:Name="CtxSigningLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Firebase:"/>
          <TextBlock x:Name="CtxFirebaseLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Secrets:"/>
          <TextBlock x:Name="CtxSecretsLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="JDK:"/>
          <TextBlock x:Name="CtxJdkLabel" Classes="ctx-value" Text="detecting…"/>
        </WrapPanel>
      </Border>

      <!-- ═══ BODY ═══ -->
      <Grid ColumnDefinitions="240,4,*">
        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource MantleBrush}" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Surface0Brush}" BorderThickness="0,1,0,0" Padding="4,6">
              <StackPanel>
                <Button x:Name="CancelButton" Classes="nav danger" Content="⏹ Cancel" Click="Cancel_Click"
                        IsEnabled="False"/>
                <Button Classes="nav" Content="🗑 Clear Log" Click="ClearLog_Click"/>
              </StackPanel>
            </Border>
            <ScrollViewer>
              <StackPanel x:Name="SidebarOps" Margin="4,6,4,4">
                <Expander Classes="nav" Header="Build" IsExpanded="True">
                  <StackPanel>
                    <Button Classes="nav" Content="Clean" Click="Clean_Click"/>
                    <Button Classes="nav" Content="Build" Click="Build_Click"
                            ToolTip.Tip="Builds the selected variant from the LOCAL project path"/>
                    <Button Classes="nav" Content="Build All" Click="BuildAll_Click"/>
                    <Button Classes="nav" Content="Lint" Click="Lint_Click"
                            ToolTip.Tip="Android Lint for the selected variant"/>
                    <Button Classes="nav" Content="List Tasks" Click="ListTasks_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Tests">
                  <StackPanel>
                    <Button Classes="nav" Content="Unit Tests" Click="UnitTests_Click"/>
                    <Button Classes="nav" Content="Instrument Tests" Click="InstrumentTests_Click"
                            ToolTip.Tip="Wipes app data on the target device when it finishes"/>
                    <Button Classes="nav accent" Content="▶ Full Test Run" Click="FullTestRun_Click"
                            ToolTip.Tip="Clean → Unit → Instrument on the LOCAL project"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Test Devices">
                  <StackPanel>
                    <TextBlock Classes="hint" Margin="4,0,4,6"
                               Text="Instrument tests wipe app data on the device they run on. When this list has entries, only these serials may be used (emulators always allowed). Empty = any device."/>
                    <ListBox x:Name="AuthorizedDevicesList" MinHeight="48" MaxHeight="96"
                             FontSize="13" Margin="4,0,4,4"/>
                    <TextBox x:Name="AuthorizedSerialBox" Margin="4,0,4,4"
                             Watermark="serial (blank = use Target)"/>
                    <Button Classes="nav" Content="Authorize Device" Click="AuthorizeDevice_Click"/>
                    <Button Classes="nav" Content="Remove Selected" Click="RemoveAuthorizedDevice_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Environment">
                  <StackPanel>
                    <Button Classes="nav" Content="List Devices" Click="Devices_Click"/>
                    <Button Classes="nav" Content="Start AVD" Click="StartAvd_Click"/>
                    <Button Classes="nav" Content="Stop Daemons" Click="StopDaemons_Click"/>
                    <Button Classes="nav" Content="Restart ADB" Click="RestartAdb_Click"/>
                    <Button Classes="nav" Content="Check Environment" Click="CheckEnv_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Cache">
                  <StackPanel>
                    <Button Classes="nav" Content="Light Clean" Click="CacheLight_Click"/>
                    <Button Classes="nav" Content="Medium Clean" Click="CacheMedium_Click"/>
                    <Button Classes="nav" Content="Heavy Clean" Click="CacheHeavy_Click"/>
                    <Button Classes="nav" Content="Lock Files Only" Click="CleanLocks_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="CI / CD">
                  <StackPanel>
                    <Button Classes="nav" Content="Promotion Settings"
                            Click="PromotionConfig_Click"/>
                    <Button Classes="nav accent" Content="Validate Promotion (Dry Run)"
                            Click="PromotionDryRun_Click"/>
                    <Button Classes="nav green" Content="▶ Promote Staging → Main"
                            Click="PromotionRun_Click"/>
                    <Button Classes="nav danger" Content="Rollback Last Promotion"
                            Click="RollbackPromotion_Click"/>
                    <Button Classes="nav" Content="Open CI Run Records"
                            Click="OpenCiRuns_Click"/>
                    <Separator/>
                    <Button x:Name="FirebaseConfigButton" Classes="nav" Content="Firebase Config"
                            Click="FirebaseConfig_Click"/>
                    <Button x:Name="BuildSignedButton" Classes="nav" Content="Build Signed APK"
                            Click="BuildSigned_Click"/>
                    <Button x:Name="DeployFirebaseButton" Classes="nav" Content="Deploy to Firebase"
                            Click="DeployFirebase_Click"/>
                    <Button x:Name="FullPipelineButton" Classes="nav green" Content="▶ Full Pipeline"
                            Click="FullPipeline_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Automation">
                  <StackPanel>
                    <Button Classes="nav" Content="Configure Schedule" Click="AutomationConfig_Click"/>
                    <Button Classes="nav accent" Content="Run Auto Now" Click="RunAutomatedDeployment_Click"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>

        <!-- RIGHT -->
        <Grid Grid.Column="2" RowDefinitions="*,4,220">
          <TabControl Grid.Row="0">
            <!-- SOURCE -->
            <TabItem Header="Source">
              <ScrollViewer Padding="18">
                <Grid MaxWidth="1180" HorizontalAlignment="Stretch" RowDefinitions="Auto,*">
                  <Border Grid.Row="0" x:Name="NoProjectBanner" Classes="empty-banner" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="＋" FontSize="28" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Add an Android project to get started" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Classes="hint" Margin="0,3,0,0"
                                   Text="Use the + button beside Project. The app will detect variants, Gradle's requested JDK, and saved repository settings."/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid Grid.Row="1" ColumnDefinitions="*,18,*">
                    <StackPanel Grid.Column="0">
                      <Border Classes="card panel-card" Margin="0,0,0,14">
                        <StackPanel>
                          <TextBlock Classes="section" Text="GITHUB ACCOUNT" Foreground="{StaticResource BlueBrush}"/>
                          <TextBlock Classes="hint" Margin="0,0,0,10"
                                     Text="Credentials are scoped to this project and stored in the system keyring."/>
                          <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Owner" Classes="form-label"/>
                            <TextBox Grid.Column="1" x:Name="MainGitHubOwnerBox" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Token" Classes="form-label"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MainGitHubTokenBox" PasswordChar="●"/>
                          </Grid>
                          <WrapPanel Margin="-4,8,0,0">
                            <Button Classes="cmd" Content="Load Repos" Click="LoadRepos_Click"/>
                            <Button Classes="cmd" Content="Save Credentials" Click="SaveCreds_Click"
                                    ToolTip.Tip="Stores the token in the system keyring"/>
                            <Button Classes="cmd" Content="Load .env" Click="LoadFromEnv_Click"/>
                            <Button Classes="cmd" Content="Save .env" Click="SaveToEnv_Click"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>

                      <Border Classes="card panel-card">
                        <StackPanel>
                          <TextBlock Classes="section" Text="REPOSITORY" Foreground="{StaticResource BlueBrush}"/>
                          <TextBlock Classes="label" Text="GitHub repository"/>
                          <ComboBox x:Name="MainGitHubRepoCombo"
                                    SelectionChanged="RepoCombo_SelectionChanged"/>
                          <TextBox x:Name="MainGitHubRepoBox" Margin="0,7,0,0"
                                   Watermark="or type a repository name"/>
                          <StackPanel Orientation="Horizontal" Margin="-4,8,0,0">
                            <Button x:Name="MainLoadBranchesButton" Classes="cmd" Content="Load Branches"
                                    Click="MainLoadBranches_Click"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <Border Classes="card panel-card" Margin="0,0,0,14">
                        <StackPanel>
                          <TextBlock Classes="section" Text="BRANCH" Foreground="{StaticResource MauveBrush}"/>
                          <TextBlock Classes="hint" Margin="0,0,0,10"
                                     Text="Choose the local source branch used by interactive build and test actions."/>
                          <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Text="Remote" Classes="form-label"/>
                            <TextBox Grid.Column="1" x:Name="MainGitRemoteBox" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Name" Classes="form-label"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MainBranchBox" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="Available" Classes="form-label"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MainBranchCombo"
                                      SelectionChanged="MainBranchCombo_SelectionChanged"/>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Margin="-4,8,0,0">
                            <Button x:Name="MainPullBranchButton" Classes="cmd primary" Content="Pull Branch"
                                    Click="MainPullBranch_Click"
                                    ToolTip.Tip="Fetch + checkout + fast-forward pull into the local project folder"/>
                            <Button Classes="cmd" Content="Repo Status" Click="RepoStatus_Click"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <Border Classes="card panel-card">
                        <StackPanel>
                          <TextBlock Classes="section" Text="WORKSPACE BEHAVIOR" Foreground="{StaticResource YellowBrush}"/>
                          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Subtext0Brush}" FontSize="13"
                                     Text="Interactive build and test actions use the project selected above. Pull Branch updates that checkout with a fast-forward-only pull. Promotion CI and rollback use isolated Git worktrees, so they never switch or reset your working branch."/>
                          <Border Classes="hr"/>
                          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Overlay0Brush}" FontSize="13"
                                     Text="The selected project's Gradle daemon criteria choose the launcher JDK automatically. Required compile toolchains are advertised separately to Gradle."/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Grid>
              </ScrollViewer>
            </TabItem>

            <!-- ISSUES -->
            <TabItem Header="Issues">
              <Grid Margin="8" RowDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Spacing="6">
                  <TextBlock Text="State:" Foreground="{StaticResource Subtext0Brush}" VerticalAlignment="Center"/>
                  <ComboBox x:Name="IssueStateCombo" Width="100" SelectedIndex="0">
                    <ComboBoxItem Content="open"/>
                    <ComboBoxItem Content="closed"/>
                    <ComboBoxItem Content="all"/>
                  </ComboBox>
                  <Button Classes="cmd" Content="Pull Issues" Click="PullIssues_Click"/>
                  <TextBlock x:Name="IssueCountLabel" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,4,*">
                  <DataGrid x:Name="IssuesGrid" SelectionChanged="IssuesGrid_SelectionChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="55"/>
                      <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                      <DataGridTextColumn Header="State" Binding="{Binding State}" Width="60"/>
                      <DataGridTextColumn Header="Labels" Binding="{Binding LabelsSummary}" Width="110"/>
                      <DataGridTextColumn Header="Date" Binding="{Binding CreatedDisplay}" Width="110"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>
                  <ScrollViewer Grid.Column="2">
                    <StackPanel Margin="10,4">
                      <TextBlock x:Name="IssueDetailHeader" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
                      <TextBlock x:Name="IssueDetailMeta" Classes="hint" Margin="0,4,0,8"/>
                      <TextBox x:Name="IssueDetailBody" IsReadOnly="True" TextWrapping="Wrap"
                               MaxHeight="200" AcceptsReturn="True" Background="{StaticResource CrustBrush}"
                               Foreground="{StaticResource Subtext0Brush}" FontSize="13"/>
                      <TextBlock x:Name="IssueCommentHeader" Text="Comments" FontWeight="Bold"
                                 Foreground="{StaticResource Subtext0Brush}" Margin="0,12,0,4"/>
                      <ItemsControl x:Name="IssueCommentsPanel">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource MantleBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,4"
                                    BorderBrush="{StaticResource Surface0Brush}" BorderThickness="1">
                              <StackPanel>
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource BlueBrush}"/>
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Separator/>
                      <TextBlock Text="Add Comment:" FontWeight="Bold" Foreground="{StaticResource Subtext0Brush}" Margin="0,0,0,4"/>
                      <TextBox x:Name="NewCommentBox" TextWrapping="Wrap" AcceptsReturn="True"
                               Height="70" VerticalContentAlignment="Top"/>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Classes="cmd" Content="Add Comment" Click="AddComment_Click"/>
                        <Button Classes="cmd danger" Content="Close Issue" Click="CloseIssue_Click"/>
                        <Button Classes="cmd success" Content="Reopen Issue" Click="ReopenIssue_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </TabItem>

            <!-- REPORTS -->
            <TabItem Header="Reports">
              <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Classes="cmd" Content="Refresh" Click="RefreshReports_Click"/>
                  <Button Classes="cmd" Content="Open Log" Click="OpenSelectedLog_Click"/>
                  <Button Classes="cmd" Content="Reports Folder" Click="OpenReports_Click"/>
                  <Button Classes="cmd" Content="Logs Folder" Click="OpenLogs_Click"/>
                </StackPanel>
                <Grid RowDefinitions="Auto,*,Auto,140">
                  <Border Grid.Row="0" Background="{StaticResource MantleBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,0,6">
                    <TextBlock x:Name="ReportsSummaryLabel" FontSize="14" Foreground="{StaticResource Subtext0Brush}"/>
                  </Border>
                  <DataGrid Grid.Row="1" x:Name="ReportsGrid" SelectionChanged="ReportsGrid_SelectionChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Date" Binding="{Binding TimestampDisplay}" Width="140"/>
                      <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="110"/>
                      <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="90"/>
                      <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="90"/>
                      <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Grid.Row="2" Text="Test failures for selected run:" FontWeight="Bold"
                             Foreground="{StaticResource RedBrush}" Margin="0,8,0,4"/>
                  <DataGrid Grid.Row="3" x:Name="FailuresGrid">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Type" Binding="{Binding TestType}" Width="90"/>
                      <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                      <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/>
                      <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </DockPanel>
            </TabItem>
          </TabControl>

          <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows"/>

          <Border Grid.Row="2" Margin="4" BorderBrush="{StaticResource Surface1Brush}" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="LogBox" Classes="log"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Border>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- Toasts float above the whole window -->
    <ui:ToastHost x:Name="Toasts"/>
  </Panel>
</Window>
