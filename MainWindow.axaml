<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AndroidCommandCenter.UI"
        x:Class="AndroidCommandCenter.MainWindow"
        Title="Android Command Center" Width="1240" Height="900"
        WindowStartupLocation="CenterScreen">
  <!-- Panel, not Grid, so the toast host floats above everything -->
  <Panel>
    <DockPanel>
      <!-- ═══ TOP BAR ═══ -->
      <Border DockPanel.Dock="Top" Background="#181825" Padding="10,6">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,200,Auto,20,Auto,170,Auto,20,Auto,150,Auto,*">
            <TextBlock Grid.Column="0" Text="Project:" Foreground="#a6adc8" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="1" x:Name="ProjectCombo" SelectionChanged="ProjectCombo_SelectionChanged"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Classes="cmd" Content="+" Width="30" Click="AddProject_Click" ToolTip.Tip="Add project folder"/>
              <Button Classes="cmd" Content="−" Width="30" Click="RemoveProject_Click" ToolTip.Tip="Remove from list"/>
            </StackPanel>
            <TextBlock Grid.Column="4" Text="Variant:" Foreground="#a6adc8" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="5" x:Name="VariantCombo" SelectionChanged="VariantCombo_SelectionChanged"/>
            <Button Grid.Column="6" Classes="cmd" Content="Detect" Click="DetectVariants_Click"/>
            <TextBlock Grid.Column="8" Text="AVD:" Foreground="#a6adc8" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="9" x:Name="AvdCombo" SelectionChanged="AvdCombo_SelectionChanged"/>
            <Button Grid.Column="10" Classes="cmd" Content="↻" Width="30" Click="RefreshAvds_Click"/>
          </Grid>

          <Grid ColumnDefinitions="Auto,130,16,Auto,130,24,Auto,24,Auto,200,16,Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="CPU" Foreground="#6c7086" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Panel Grid.Column="1">
              <ProgressBar x:Name="CpuBar" Classes="dash" Maximum="100" Foreground="#89b4fa"/>
              <TextBlock x:Name="CpuLabel" Text="—" FontSize="10" FontWeight="Bold" Foreground="#11111b"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>
            <TextBlock Grid.Column="3" Text="RAM" Foreground="#6c7086" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Panel Grid.Column="4">
              <ProgressBar x:Name="MemBar" Classes="dash" Maximum="100" Foreground="#a6e3a1"/>
              <TextBlock x:Name="MemLabel" Text="—" FontSize="10" FontWeight="Bold" Foreground="#11111b"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Panel>
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Java:" Foreground="#a6adc8" FontSize="12"/>
              <TextBlock x:Name="DaemonLabel" Text="0" Foreground="#f9e2af" FontWeight="Bold"
                         FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="8" Text="Target:" Foreground="#a6adc8" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Grid.Column="9" x:Name="DeviceCombo" SelectionChanged="DeviceCombo_SelectionChanged"/>
            <TextBlock Grid.Column="11" Text="Connected:" Foreground="#a6adc8" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Grid.Column="12" x:Name="DeviceListLabel" Text="(scanning…)" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="13" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
              <ProgressBar x:Name="BusySpinner" IsIndeterminate="True" IsVisible="False"
                           Width="80" Height="4"/>
              <TextBlock Text="Status:" Foreground="#a6adc8" FontSize="12"/>
              <TextBlock x:Name="StatusLabel" Text="Idle" Foreground="#a6e3a1"
                         FontWeight="Bold" FontSize="12"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ CONTEXT BANNER ═══ -->
      <Border DockPanel.Dock="Top" Classes="ctx-banner">
        <WrapPanel>
          <TextBlock Classes="ctx-key" Text="Working on:"/>
          <TextBlock x:Name="CtxProjectLabel" Classes="ctx-value" Text="(no project)"/>
          <TextBlock Classes="ctx-key" Text="Repo:"/>
          <TextBlock x:Name="CtxRepoLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Branch:"/>
          <TextBlock x:Name="CtxBranchLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Signing:"/>
          <TextBlock x:Name="CtxSigningLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Firebase:"/>
          <TextBlock x:Name="CtxFirebaseLabel" Classes="ctx-value" Text="—"/>
          <TextBlock Classes="ctx-key" Text="Secrets:"/>
          <TextBlock x:Name="CtxSecretsLabel" Classes="ctx-value" Text="—"/>
        </WrapPanel>
      </Border>

      <!-- ═══ BODY ═══ -->
      <Grid ColumnDefinitions="220,4,*">
        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="0,0,1,0">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="#313244" BorderThickness="0,1,0,0" Padding="4,6">
              <StackPanel>
                <Button x:Name="CancelButton" Classes="nav danger" Content="⏹ Cancel" Click="Cancel_Click"
                        IsEnabled="False"/>
                <Button Classes="nav" Content="🗑 Clear Log" Click="ClearLog_Click"/>
              </StackPanel>
            </Border>
            <ScrollViewer>
              <StackPanel x:Name="SidebarOps" Margin="4,6,4,4">
                <Expander Classes="nav" Header="Build" IsExpanded="True">
                  <StackPanel>
                    <Button Classes="nav" Content="Clean" Click="Clean_Click"/>
                    <Button Classes="nav" Content="Build" Click="Build_Click"
                            ToolTip.Tip="Builds the selected variant from the LOCAL project path"/>
                    <Button Classes="nav" Content="Build All" Click="BuildAll_Click"/>
                    <Button Classes="nav" Content="Lint" Click="Lint_Click"
                            ToolTip.Tip="Android Lint for the selected variant"/>
                    <Button Classes="nav" Content="List Tasks" Click="ListTasks_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Tests" IsExpanded="True">
                  <StackPanel>
                    <Button Classes="nav" Content="Unit Tests" Click="UnitTests_Click"/>
                    <Button Classes="nav" Content="Instrument Tests" Click="InstrumentTests_Click"
                            ToolTip.Tip="Wipes app data on the target device when it finishes"/>
                    <Button Classes="nav accent" Content="▶ Full Test Run" Click="FullTestRun_Click"
                            ToolTip.Tip="Clean → Unit → Instrument on the LOCAL project"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Test Devices">
                  <StackPanel>
                    <TextBlock Classes="hint" Margin="4,0,4,6"
                               Text="Instrument tests wipe app data on the device they run on. When this list has entries, only these serials may be used (emulators always allowed). Empty = any device."/>
                    <ListBox x:Name="AuthorizedDevicesList" MinHeight="48" MaxHeight="96"
                             FontSize="12" Margin="4,0,4,4"/>
                    <TextBox x:Name="AuthorizedSerialBox" Margin="4,0,4,4"
                             Watermark="serial (blank = use Target)"/>
                    <Button Classes="nav" Content="Authorize Device" Click="AuthorizeDevice_Click"/>
                    <Button Classes="nav" Content="Remove Selected" Click="RemoveAuthorizedDevice_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Environment" IsExpanded="True">
                  <StackPanel>
                    <Button Classes="nav" Content="List Devices" Click="Devices_Click"/>
                    <Button Classes="nav" Content="Start AVD" Click="StartAvd_Click"/>
                    <Button Classes="nav" Content="Stop Daemons" Click="StopDaemons_Click"/>
                    <Button Classes="nav" Content="Restart ADB" Click="RestartAdb_Click"/>
                    <Button Classes="nav" Content="Check Environment" Click="CheckEnv_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Cache">
                  <StackPanel>
                    <Button Classes="nav" Content="Light Clean" Click="CacheLight_Click"/>
                    <Button Classes="nav" Content="Medium Clean" Click="CacheMedium_Click"/>
                    <Button Classes="nav" Content="Heavy Clean" Click="CacheHeavy_Click"/>
                    <Button Classes="nav" Content="Lock Files Only" Click="CleanLocks_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="CI / CD">
                  <StackPanel>
                    <Button Classes="nav" Content="Promotion Settings"
                            Click="PromotionConfig_Click"/>
                    <Button Classes="nav accent" Content="Validate Promotion (Dry Run)"
                            Click="PromotionDryRun_Click"/>
                    <Button Classes="nav green" Content="▶ Promote Staging → Main"
                            Click="PromotionRun_Click"/>
                    <Button Classes="nav danger" Content="Rollback Last Promotion"
                            Click="RollbackPromotion_Click"/>
                    <Button Classes="nav" Content="Open CI Run Records"
                            Click="OpenCiRuns_Click"/>
                    <Separator/>
                    <Button x:Name="FirebaseConfigButton" Classes="nav" Content="Firebase Config"
                            Click="FirebaseConfig_Click"/>
                    <Button x:Name="BuildSignedButton" Classes="nav" Content="Build Signed APK"
                            Click="BuildSigned_Click"/>
                    <Button x:Name="DeployFirebaseButton" Classes="nav" Content="Deploy to Firebase"
                            Click="DeployFirebase_Click"/>
                    <Button x:Name="FullPipelineButton" Classes="nav green" Content="▶ Full Pipeline"
                            Click="FullPipeline_Click"/>
                  </StackPanel>
                </Expander>

                <Expander Classes="nav" Header="Automation">
                  <StackPanel>
                    <Button Classes="nav" Content="Configure Schedule" Click="AutomationConfig_Click"/>
                    <Button Classes="nav accent" Content="Run Auto Now" Click="RunAutomatedDeployment_Click"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>

        <!-- RIGHT -->
        <Grid Grid.Column="2" RowDefinitions="*,4,220">
          <TabControl Grid.Row="0">
            <!-- SOURCE -->
            <TabItem Header="Source">
              <ScrollViewer Padding="12">
                <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
                  <TextBlock Classes="section" Text="GITHUB ACCOUNT" Foreground="#89b4fa"/>
                  <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Owner:" Foreground="#a6adc8" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="MainGitHubOwnerBox" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Token:" Foreground="#a6adc8" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MainGitHubTokenBox" PasswordChar="●"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Classes="cmd" Content="Load Repos" Click="LoadRepos_Click"/>
                    <Button Classes="cmd" Content="Save Credentials" Click="SaveCreds_Click"
                            ToolTip.Tip="Stores the token in the system keyring"/>
                    <Button Classes="cmd" Content="Load .env" Click="LoadFromEnv_Click"/>
                    <Button Classes="cmd" Content="Save .env" Click="SaveToEnv_Click"/>
                  </StackPanel>

                  <Separator/>
                  <TextBlock Classes="section" Text="REPOSITORY" Foreground="#89b4fa"/>
                  <Grid ColumnDefinitions="80,*">
                    <TextBlock Text="Repo:" Foreground="#a6adc8" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="MainGitHubRepoCombo"
                              SelectionChanged="RepoCombo_SelectionChanged"/>
                  </Grid>
                  <TextBox x:Name="MainGitHubRepoBox" Margin="80,6,0,0"
                           Watermark="or type a repository name"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="MainLoadBranchesButton" Classes="cmd" Content="Load Branches"
                            Click="MainLoadBranches_Click"/>
                  </StackPanel>

                  <Separator/>
                  <TextBlock Classes="section" Text="BRANCH" Foreground="#cba6f7"/>
                  <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Remote:" Foreground="#a6adc8" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="MainGitRemoteBox" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Name:" Foreground="#a6adc8" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MainBranchBox" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Text="Select:" Foreground="#a6adc8" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MainBranchCombo"
                              SelectionChanged="MainBranchCombo_SelectionChanged"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="MainPullBranchButton" Classes="cmd" Content="Pull Branch"
                            Click="MainPullBranch_Click"
                            ToolTip.Tip="Fetch + checkout + fast-forward pull into the LOCAL project folder"/>
                    <Button Classes="cmd" Content="Repo Status" Click="RepoStatus_Click"/>
                  </StackPanel>

                  <Border Classes="card" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="#6c7086" FontSize="12">
                      <Run FontWeight="Bold" Foreground="#f9e2af">How it works:</Run><LineBreak/>
                      All build, test, and deploy operations run against the
                      <Run FontWeight="Bold" Foreground="#cdd6f4">local project path</Run> selected in the top bar.
                      <LineBreak/><LineBreak/>
                      "Pull Branch" updates the local checkout to match a remote branch. Use it before
                      building if you want to test a specific branch.
                      <LineBreak/><LineBreak/>
                      Credentials are stored per-project in the system keyring and auto-load when you
                      switch projects.
                    </TextBlock>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ISSUES -->
            <TabItem Header="Issues">
              <Grid Margin="8" RowDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Spacing="6">
                  <TextBlock Text="State:" Foreground="#a6adc8" VerticalAlignment="Center"/>
                  <ComboBox x:Name="IssueStateCombo" Width="100" SelectedIndex="0">
                    <ComboBoxItem Content="open"/>
                    <ComboBoxItem Content="closed"/>
                    <ComboBoxItem Content="all"/>
                  </ComboBox>
                  <Button Classes="cmd" Content="Pull Issues" Click="PullIssues_Click"/>
                  <TextBlock x:Name="IssueCountLabel" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,4,*">
                  <DataGrid x:Name="IssuesGrid" SelectionChanged="IssuesGrid_SelectionChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="55"/>
                      <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                      <DataGridTextColumn Header="State" Binding="{Binding State}" Width="60"/>
                      <DataGridTextColumn Header="Labels" Binding="{Binding LabelsSummary}" Width="110"/>
                      <DataGridTextColumn Header="Date" Binding="{Binding CreatedDisplay}" Width="110"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"/>
                  <ScrollViewer Grid.Column="2">
                    <StackPanel Margin="10,4">
                      <TextBlock x:Name="IssueDetailHeader" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                      <TextBlock x:Name="IssueDetailMeta" Classes="hint" Margin="0,4,0,8"/>
                      <TextBox x:Name="IssueDetailBody" IsReadOnly="True" TextWrapping="Wrap"
                               MaxHeight="200" AcceptsReturn="True" Background="#11111b"
                               Foreground="#a6adc8" FontSize="12"/>
                      <TextBlock x:Name="IssueCommentHeader" Text="Comments" FontWeight="Bold"
                                 Foreground="#a6adc8" Margin="0,12,0,4"/>
                      <ItemsControl x:Name="IssueCommentsPanel">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#181825" CornerRadius="4" Padding="8,6" Margin="0,0,0,4"
                                    BorderBrush="#313244" BorderThickness="1">
                              <StackPanel>
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="11"
                                           Foreground="#89b4fa"/>
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Separator/>
                      <TextBlock Text="Add Comment:" FontWeight="Bold" Foreground="#a6adc8" Margin="0,0,0,4"/>
                      <TextBox x:Name="NewCommentBox" TextWrapping="Wrap" AcceptsReturn="True"
                               Height="70" VerticalContentAlignment="Top"/>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Classes="cmd" Content="Add Comment" Click="AddComment_Click"/>
                        <Button Classes="cmd danger" Content="Close Issue" Click="CloseIssue_Click"/>
                        <Button Classes="cmd success" Content="Reopen Issue" Click="ReopenIssue_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </TabItem>

            <!-- REPORTS -->
            <TabItem Header="Reports">
              <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Classes="cmd" Content="Refresh" Click="RefreshReports_Click"/>
                  <Button Classes="cmd" Content="Open Log" Click="OpenSelectedLog_Click"/>
                  <Button Classes="cmd" Content="Reports Folder" Click="OpenReports_Click"/>
                  <Button Classes="cmd" Content="Logs Folder" Click="OpenLogs_Click"/>
                </StackPanel>
                <Grid RowDefinitions="Auto,*,Auto,140">
                  <Border Grid.Row="0" Background="#181825" CornerRadius="4" Padding="12,6" Margin="0,0,0,6">
                    <TextBlock x:Name="ReportsSummaryLabel" FontSize="13" Foreground="#a6adc8"/>
                  </Border>
                  <DataGrid Grid.Row="1" x:Name="ReportsGrid" SelectionChanged="ReportsGrid_SelectionChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Date" Binding="{Binding TimestampDisplay}" Width="140"/>
                      <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="110"/>
                      <DataGridTextColumn Header="Variant" Binding="{Binding Variant}" Width="90"/>
                      <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="90"/>
                      <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Grid.Row="2" Text="Test failures for selected run:" FontWeight="Bold"
                             Foreground="#f38ba8" Margin="0,8,0,4"/>
                  <DataGrid Grid.Row="3" x:Name="FailuresGrid">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Type" Binding="{Binding TestType}" Width="90"/>
                      <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="*"/>
                      <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/>
                      <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
              </DockPanel>
            </TabItem>
          </TabControl>

          <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows"/>

          <Border Grid.Row="2" Margin="4" BorderBrush="#45475a" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="LogBox" Classes="log"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Border>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- Toasts float above the whole window -->
    <ui:ToastHost x:Name="Toasts"/>
  </Panel>
</Window>
