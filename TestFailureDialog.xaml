<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndroidCommandCenter.TestFailureDialog"
        Title="Test Failure" Width="700" Height="540"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontWeight="Bold" Foreground="#f38ba8" FontSize="16"/>
            <TextBlock x:Name="CountText" Classes="hint" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="ConfirmCheck" IsVisible="False" Foreground="#f9e2af"
                      Content="I understand the failure and want to proceed anyway"
                      IsCheckedChanged="Confirm_Changed"/>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
                <Button Grid.Column="0" Classes="cmd" Content="Copy details" Click="Copy_Click"/>
                <Button Grid.Column="2" x:Name="ContinueBtn" Classes="cmd success"
                        Content="Continue anyway" Click="Continue_Click"/>
                <Button Grid.Column="3" Classes="cmd danger" Content="Stop Pipeline" Click="Stop_Click"/>
            </Grid>
        </StackPanel>
        <TextBox x:Name="DetailsBox" Classes="log"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 BorderThickness="1" BorderBrush="#45475a"/>
    </DockPanel>
</Window>