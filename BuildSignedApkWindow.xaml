<Window x:Class="AndroidCommandCenter.BuildSignedApkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Signed APK" Height="600" Width="580"
        Background="#1e1e2e" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8,16,12">
            <Button x:Name="GenerateBtn" Content="Generate Signed APK" Style="{StaticResource CmdButton}"
                    Click="Generate_Click" Background="#40a02b" Foreground="White" FontWeight="Bold" Padding="20,6" />
            <Button Content="Cancel" Style="{StaticResource CmdButton}" Click="Cancel_Click" Padding="20,6" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <TextBlock Text="SIGNING" FontWeight="Bold" Foreground="#89b4fa" FontSize="14" Margin="0,0,0,8" />

                <TextBlock Text="Keystore file (.jks):" Foreground="#a6adc8" Margin="0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="KeystoreBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource CmdButton}" Click="BrowseKeystore_Click" />
                </Grid>

                <TextBlock Text="Keystore password:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <PasswordBox x:Name="StorePassBox" Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" Padding="6,4" FontSize="13" PasswordChanged="Pass_Changed" />

                <TextBlock Text="Key alias:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <TextBox x:Name="KeyAliasBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

                <TextBlock Text="Key password:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <PasswordBox x:Name="KeyPassBox" Background="#313244" Foreground="#cdd6f4"
                             BorderBrush="#45475a" Padding="6,4" FontSize="13" PasswordChanged="Pass_Changed" />

                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,14,0,8" />
                <TextBlock Text="VARIANTS TO BUILD" FontWeight="Bold" Foreground="#89b4fa" FontSize="14" Margin="0,0,0,6" />
                <TextBlock Text="Select one or more (usually the release variants):" Foreground="#a6adc8" Margin="0,0,0,6" />
                <ItemsControl x:Name="VariantList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Foreground="#cdd6f4" FontSize="13" Margin="0,3"
                                      Checked="Variant_Changed" Unchecked="Variant_Changed" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>