<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AndroidCommandCenter.UI"
        x:Class="AndroidCommandCenter.BuildSignedApkWindow"
        Title="Build Signed APK" Width="600" Height="620"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,8,16,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="SummaryText" Classes="field-error" VerticalAlignment="Center" IsVisible="False"/>
        <Button Grid.Column="1" x:Name="GenerateBtn" Classes="cmd success"
                Content="Generate Signed APK" Click="Generate_Click"/>
        <Button Grid.Column="2" Classes="cmd" Content="Cancel" Click="Cancel_Click" Padding="20,6"/>
      </Grid>
    </Border>
    <ScrollViewer Padding="16,12">
      <StackPanel>
        <TextBlock Classes="section" Text="SIGNING" Foreground="#89b4fa"/>

        <TextBlock Classes="label" Text="Keystore file (.jks):"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="KeystoreBox" TextChanged="Field_Changed"/>
          <Button Grid.Column="1" Classes="cmd" Content="Browse…" Click="BrowseKeystore_Click"/>
        </Grid>
        <TextBlock x:Name="KeystoreErr" Classes="field-error" IsVisible="False"/>

        <TextBlock Classes="label" Text="Keystore password:"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="StorePassBox" PasswordChar="●" TextChanged="Field_Changed"/>
          <ToggleButton Grid.Column="1" x:Name="RevealToggle" Classes="cmd" Content="👁"
                        IsCheckedChanged="Reveal_Changed" ToolTip.Tip="Show/hide passwords"/>
        </Grid>
        <TextBlock x:Name="StorePassErr" Classes="field-error" IsVisible="False"/>

        <TextBlock Classes="label" Text="Key alias:"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="KeyAliasBox" TextChanged="Field_Changed"/>
          <Button Grid.Column="1" x:Name="VerifyBtn" Classes="cmd" Content="Verify keystore"
                  Click="Verify_Click" ToolTip.Tip="Runs keytool to confirm the password and alias"/>
        </Grid>
        <TextBlock x:Name="KeyAliasErr" Classes="field-error" IsVisible="False"/>

        <TextBlock Classes="label" Text="Key password:"/>
        <TextBox x:Name="KeyPassBox" PasswordChar="●" TextChanged="Field_Changed"/>
        <TextBlock x:Name="KeyPassErr" Classes="field-error" IsVisible="False"/>
        <TextBlock x:Name="VerifyInfo" Classes="hint" Margin="2,6,0,0" TextWrapping="Wrap"/>

        <Border Classes="hr"/>
        <TextBlock Classes="section" Text="VARIANTS TO BUILD" Foreground="#89b4fa"/>
        <TextBlock Classes="hint" Text="Usually the release variant(s). Each selected variant is built and signed with the keystore above."/>
        <ItemsControl x:Name="VariantList" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:VariantChoice">
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="VariantErr" Classes="field-error" IsVisible="False"/>

        <Border Classes="card" Margin="0,14,0,0">
          <TextBlock Classes="hint" TextWrapping="Wrap" Foreground="#f9e2af"
                     Text="These credentials override the signing config of every build type. Only use the output for distribution — installing a differently-signed APK over an existing install forces an uninstall and wipes app data."/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>