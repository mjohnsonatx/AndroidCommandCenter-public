<Window x:Class="AndroidCommandCenter.FirebaseConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firebase Configuration" Height="340" Width="560"
        Background="#1e1e2e" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8,16,12">
            <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource CmdButton}"
                    Click="Save_Click" Background="#1e66f5" Foreground="White" FontWeight="Bold" Padding="20,6" />
            <Button Content="Cancel" Style="{StaticResource CmdButton}" Click="Cancel_Click" Padding="20,6" />
        </StackPanel>
        <StackPanel Margin="16,12">
            <TextBlock Text="FIREBASE CONFIGURATION" FontWeight="Bold" Foreground="#a6e3a1" FontSize="14" Margin="0,0,0,10" />

            <TextBlock Text="Firebase App ID (e.g. 1:123:android:abc):" Foreground="#a6adc8" Margin="0,4" />
            <TextBox x:Name="AppIdBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

            <TextBlock Text="Service Account JSON (credentials):" Foreground="#a6adc8" Margin="0,8,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="JsonBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                <Button Grid.Column="1" Content="Browse" Style="{StaticResource CmdButton}" Click="BrowseJson_Click" />
            </Grid>

            <TextBlock Text="Firebase CLI command/path:" Foreground="#a6adc8" Margin="0,8,0,4" />
            <TextBox x:Name="CliBox" Style="{StaticResource DarkTextBox}" />

            <TextBlock TextWrapping="Wrap" Foreground="#6c7086" FontSize="11" Margin="0,10,0,0"
                       Text="Must be a Google service-account JSON with the Firebase App Distribution Admin role — NOT google-services.json." />
        </StackPanel>
    </DockPanel>
</Window>