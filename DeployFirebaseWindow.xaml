<Window x:Class="AndroidCommandCenter.DeployFirebaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deploy to Firebase" Height="480" Width="560"
        Background="#1e1e2e" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8,16,12">
            <Button x:Name="DeployBtn" Content="Deploy" Style="{StaticResource CmdButton}"
                    Click="Deploy_Click" Background="#40a02b" Foreground="White" FontWeight="Bold" Padding="20,6" />
            <Button Content="Cancel" Style="{StaticResource CmdButton}" Click="Cancel_Click" Padding="20,6" />
        </StackPanel>
        <StackPanel Margin="16,12">
            <TextBlock Text="DEPLOY TO FIREBASE" FontWeight="Bold" Foreground="#a6e3a1" FontSize="14" Margin="0,0,0,10" />

            <TextBlock Text="APK file:" Foreground="#a6adc8" Margin="0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ApkBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                <Button Grid.Column="1" Content="Browse" Style="{StaticResource CmdButton}" Click="BrowseApk_Click" />
            </Grid>

            <TextBlock Text="Tester groups (comma-separated):" Foreground="#a6adc8" Margin="0,4" />
            <TextBox x:Name="GroupsBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

            <TextBlock Text="Tester emails (comma-separated, optional):" Foreground="#a6adc8" Margin="0,8,0,4" />
            <TextBox x:Name="EmailsBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

            <TextBlock Text="Release notes:" Foreground="#a6adc8" Margin="0,8,0,4" />
            <TextBox x:Name="NotesBox" Style="{StaticResource DarkTextBox}"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="120" VerticalContentAlignment="Top" />
        </StackPanel>
    </DockPanel>
</Window>
