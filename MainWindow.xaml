<Window x:Class="AndroidCommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Command Center"
        Height="780"
        Width="1050"
        Background="#1e1e2e"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- ═══ PROJECT + VARIANT SELECTORS ═══════ -->
        <Border DockPanel.Dock="Top"
                Background="#181825"
                Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Project row -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Project:"
                           Foreground="#a6adc8"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <ComboBox  Grid.Row="0"
                           Grid.Column="1"
                           x:Name="ProjectCombo"
                           Style="{StaticResource DarkComboBox}"
                           SelectionChanged="ProjectCombo_SelectionChanged" />
                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="+ Add"
                            Style="{StaticResource CmdButton}"
                            Click="AddProject_Click" />
                    <Button Content="- Remove"
                            Style="{StaticResource CmdButton}"
                            Click="RemoveProject_Click" />
                </StackPanel>

                <!-- Variant row -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Variant:"
                           Foreground="#a6adc8"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,6,0,0" />
                <ComboBox  Grid.Row="1"
                           Grid.Column="1"
                           x:Name="VariantCombo"
                           Style="{StaticResource DarkComboBox}"
                           Margin="0,6,0,0"
                           SelectionChanged="VariantCombo_SelectionChanged" />
                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,6,0,0">
                    <Button  Content="Detect"
                             Style="{StaticResource CmdButton}"
                             Click="DetectVariants_Click"
                             ToolTip="Auto-detect from build.gradle" />
                    <TextBox x:Name="CustomVariantBox"
                             Style="{StaticResource DarkTextBox}"
                             Width="110"
                             Margin="4,0,0,0"
                             ToolTip="e.g. FreeDebug"
                             KeyDown="CustomVariantBox_KeyDown" />
                    <Button  Content="+Add"
                             Style="{StaticResource CmdButton}"
                             Click="AddVariant_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ LIVE DASHBOARD ════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="#11111b"
                Padding="12,6"
                BorderBrush="#313244"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <TextBlock Grid.Column="0"
                           Text="CPU"
                           Foreground="#6c7086"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="11" />
                <Grid Grid.Column="1">
                    <ProgressBar x:Name="CpuBar"
                                 Style="{StaticResource DashBar}"
                                 Value="0"
                                 Maximum="100"
                                 Foreground="#89b4fa" />
                    <TextBlock   x:Name="CpuLabel"
                                 Text="0%"
                                 FontSize="10"
                                 Foreground="#cdd6f4"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                </Grid>

                <!-- RAM -->
                <TextBlock Grid.Column="3"
                           Text="RAM"
                           Foreground="#6c7086"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="11" />
                <Grid Grid.Column="4">
                    <ProgressBar x:Name="MemBar"
                                 Style="{StaticResource DashBar}"
                                 Value="0"
                                 Maximum="100"
                                 Foreground="#a6e3a1" />
                    <TextBlock   x:Name="MemLabel"
                                 Text="0 MB"
                                 FontSize="10"
                                 Foreground="#cdd6f4"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                </Grid>

                <!-- Java/daemon count -->
                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Java: "
                               Foreground="#6c7086"
                               FontSize="11" />
                    <TextBlock x:Name="DaemonLabel"
                               Text="0"
                               Foreground="#f9e2af"
                               FontWeight="Bold"
                               FontSize="11" />
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="8"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="Status: "
                               Foreground="#6c7086"
                               FontSize="11" />
                    <TextBlock x:Name="StatusLabel"
                               Text="Idle"
                               Foreground="#a6e3a1"
                               FontWeight="SemiBold"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ COMMAND BUTTONS ═══════════════════ -->
        <ScrollViewer DockPanel.Dock="Top"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="260">
            <WrapPanel Margin="4">

                <GroupBox Header="Build">
                    <WrapPanel>
                        <Button Content="Clean"
                                Style="{StaticResource CmdButton}"
                                Click="Clean_Click" />
                        <Button Content="Build"
                                Style="{StaticResource CmdButton}"
                                Click="Build_Click"
                                ToolTip="Build selected variant" />
                        <Button Content="Build All"
                                Style="{StaticResource CmdButton}"
                                Click="BuildAll_Click"
                                ToolTip="Build every variant" />
                        <Button Content="List Tasks"
                                Style="{StaticResource CmdButton}"
                                Click="ListTasks_Click" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Tests">
                    <WrapPanel>
                        <Button Content="Unit Tests"
                                Style="{StaticResource CmdButton}"
                                Click="UnitTests_Click" />
                        <Button Content="Instrument Tests"
                                Style="{StaticResource CmdButton}"
                                Click="InstrumentTests_Click" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Environment">
                    <WrapPanel>
                        <Button Content="List Devices"
                                Style="{StaticResource CmdButton}"
                                Click="Devices_Click" />
                        <Button Content="Start AVD"
                                Style="{StaticResource CmdButton}"
                                Click="StartAvd_Click" />
                        <Button Content="Stop Daemons"
                                Style="{StaticResource CmdButton}"
                                Click="StopDaemons_Click" />
                        <Button Content="Restart ADB"
                                Style="{StaticResource CmdButton}"
                                Click="RestartAdb_Click" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Cache Invalidation">
                    <WrapPanel>
                        <Button Content="Light Clean"
                                Style="{StaticResource CmdButton}"
                                Click="CacheLight_Click"
                                ToolTip="Stop daemons + delete build dirs" />
                        <Button Content="Medium Clean"
                                Style="{StaticResource CmdButton}"
                                Click="CacheMedium_Click"
                                ToolTip="+ project .gradle, lock files, .idea caches" />
                        <Button Content="Heavy Clean"
                                Style="{StaticResource CmdButton}"
                                Click="CacheHeavy_Click"
                                ToolTip="+ global gradle caches (re-downloads deps!)" />
                        <Button Content="Lock Files Only"
                                Style="{StaticResource CmdButton}"
                                Click="CleanLocks_Click" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Workflows">
                    <WrapPanel>
                        <Button Content="Full Test Run"
                                Style="{StaticResource CmdButton}"
                                Click="FullTestRun_Click"
                                FontWeight="Bold"
                                Background="#1e66f5"
                                Foreground="White" />
                        <Button Content="Cancel"
                                Style="{StaticResource CmdButton}"
                                Click="Cancel_Click"
                                Background="#e64553"
                                Foreground="White" />
                        <Button Content="Clear Log"
                                Style="{StaticResource CmdButton}"
                                Click="ClearLog_Click" />
                    </WrapPanel>
                </GroupBox>

            </WrapPanel>
        </ScrollViewer>

        <!-- ═══ LOG OUTPUT ════════════════════════ -->
        <Border Margin="8"
                BorderBrush="#45475a"
                BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     Background="#11111b"
                     Foreground="#a6adc8"
                     BorderThickness="0"
                     Padding="8" />
        </Border>

    </DockPanel>
</Window>