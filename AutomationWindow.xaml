<Window x:Class="AndroidCommandCenter.AutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automated Deployment" Height="740" Width="600"
        Background="#1e1e2e" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8,16,12">
            <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource CmdButton}"
                    Click="Save_Click" Padding="20,6" />
            <Button x:Name="SaveRunBtn" Content="Save + Run" Style="{StaticResource CmdButton}"
                    Click="SaveRun_Click" Background="#40a02b" Foreground="White"
                    FontWeight="Bold" Padding="20,6" />
            <Button Content="Cancel" Style="{StaticResource CmdButton}" Click="Cancel_Click" Padding="20,6" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <TextBlock Text="GIT SOURCE" FontWeight="Bold" Foreground="#89b4fa" FontSize="14" Margin="0,0,0,8" />
                <TextBlock Text="Remote:" Foreground="#a6adc8" Margin="0,4" />
                <TextBox x:Name="RemoteBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                <TextBlock Text="Branch:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <TextBox x:Name="BranchBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,14,0,8" />
                <TextBlock Text="SCHEDULE" FontWeight="Bold" Foreground="#fab387" FontSize="14" Margin="0,0,0,8" />
                <CheckBox x:Name="RecurringCheck" Content="Run automated deployment on a recurring schedule"
                          Foreground="#cdd6f4" FontSize="13" Margin="0,3"
                          Checked="RecurringCheck_Changed" Unchecked="RecurringCheck_Changed" />

                <StackPanel x:Name="SchedulePanel" Margin="0,8,0,0">
                    <TextBlock Text="Daily run times (24-hour HH:mm, comma-separated):" Foreground="#a6adc8" Margin="0,4" />
                    <TextBox x:Name="RunTimesBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                </StackPanel>

                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,14,0,8" />
                <TextBlock Text="TEST FAILURE DECISION" FontWeight="Bold" Foreground="#f9e2af" FontSize="14" Margin="0,0,0,8" />
                <ComboBox x:Name="FailureCombo" Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="Automatic bounce back (stop on failure)" />
                    <ComboBoxItem Content="Warning (notify and continue)" />
                    <ComboBoxItem Content="Warning + confirm to proceed" />
                    <ComboBoxItem Content="Silent (ignore failures)" />
                </ComboBox>

                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,14,0,8" />
                <TextBlock Text="EMAIL LOG REPORT" FontWeight="Bold" Foreground="#a6e3a1" FontSize="14" Margin="0,0,0,8" />
                <CheckBox x:Name="EmailCheck" Content="Send email when automation finishes"
                          Foreground="#cdd6f4" FontSize="13" Margin="0,3"
                          Checked="EmailCheck_Changed" Unchecked="EmailCheck_Changed" />

                <StackPanel x:Name="EmailPanel" Margin="0,8,0,0">
                    <TextBlock Text="Recipient email:" Foreground="#a6adc8" Margin="0,4" />
                    <TextBox x:Name="ToBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

                    <TextBlock Text="From email:" Foreground="#a6adc8" Margin="0,8,0,4" />
                    <TextBox x:Name="FromBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

                    <TextBlock Text="SMTP host:" Foreground="#a6adc8" Margin="0,8,0,4" />
                    <TextBox x:Name="SmtpHostBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SMTP port:" Foreground="#a6adc8" Margin="0,0,0,4" />
                            <TextBox x:Name="SmtpPortBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="SslCheck" Content="Use SSL/TLS"
                                  Foreground="#cdd6f4" FontSize="13" Margin="12,22,0,0" />
                    </Grid>

                    <TextBlock Text="SMTP username:" Foreground="#a6adc8" Margin="0,8,0,4" />
                    <TextBox x:Name="UserBox" Style="{StaticResource DarkTextBox}" />

                    <TextBlock Text="SMTP password:" Foreground="#a6adc8" Margin="0,8,0,4" />
                    <PasswordBox x:Name="PasswordBox" Background="#313244" Foreground="#cdd6f4"
                                 BorderBrush="#45475a" Padding="6,4" FontSize="13" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
