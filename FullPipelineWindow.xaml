<Window x:Class="AndroidCommandCenter.FullPipelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full Pipeline" Height="760" Width="600"
        Background="#1e1e2e" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8,16,12">
            <Button x:Name="RunBtn" Content="Run Pipeline" Style="{StaticResource CmdButton}"
                    Click="Run_Click" Background="#40a02b" Foreground="White" FontWeight="Bold" Padding="20,6" />
            <Button Content="Cancel" Style="{StaticResource CmdButton}" Click="Cancel_Click" Padding="20,6" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>

                <!-- Signing -->
                <TextBlock Text="SIGNING" FontWeight="Bold" Foreground="#89b4fa" FontSize="14" Margin="0,0,0,8" />
                <TextBlock Text="Keystore file (.jks):" Foreground="#a6adc8" Margin="0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="KeystoreBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource CmdButton}" Click="BrowseKeystore_Click" />
                </Grid>
                <TextBlock Text="Keystore password:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <PasswordBox x:Name="StorePassBox" Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                             Padding="6,4" FontSize="13" PasswordChanged="Pass_Changed" />
                <TextBlock Text="Key alias:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <TextBox x:Name="KeyAliasBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                <TextBlock Text="Key password:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <PasswordBox x:Name="KeyPassBox" Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"
                             Padding="6,4" FontSize="13" PasswordChanged="Pass_Changed" />

                <!-- Variants -->
                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,14,0,8" />
                <TextBlock Text="VARIANTS TO BUILD" FontWeight="Bold" Foreground="#89b4fa" FontSize="14" Margin="0,0,0,6" />
                <ItemsControl x:Name="VariantList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Foreground="#cdd6f4" FontSize="13" Margin="0,3"
                                      Checked="Variant_Changed" Unchecked="Variant_Changed" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Firebase -->
                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,14,0,8" />
                <TextBlock Text="FIREBASE" FontWeight="Bold" Foreground="#a6e3a1" FontSize="14" Margin="0,0,0,8" />
                <TextBlock Text="App ID:" Foreground="#a6adc8" Margin="0,4" />
                <TextBox x:Name="AppIdBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                <TextBlock Text="Service Account JSON:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="JsonBox" Style="{StaticResource DarkTextBox}" TextChanged="Field_Changed" />
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource CmdButton}" Click="BrowseJson_Click" />
                </Grid>
                <TextBlock Text="Tester groups:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <TextBox x:Name="GroupsBox" Style="{StaticResource DarkTextBox}" />
                <TextBlock Text="Tester emails (optional):" Foreground="#a6adc8" Margin="0,8,0,4" />
                <TextBox x:Name="EmailsBox" Style="{StaticResource DarkTextBox}" />
                <TextBlock Text="Release notes:" Foreground="#a6adc8" Margin="0,8,0,4" />
                <TextBox x:Name="NotesBox" Style="{StaticResource DarkTextBox}" TextWrapping="Wrap"
                         AcceptsReturn="True" Height="60" VerticalContentAlignment="Top" />

                <!-- Tests -->
                <Border BorderBrush="#45475a" BorderThickness="0,1,0,0" Margin="0,14,0,8" />
                <TextBlock Text="TESTS" FontWeight="Bold" Foreground="#f9e2af" FontSize="14" Margin="0,0,0,8" />
                <CheckBox x:Name="RunUnitCheck" Content="Run unit tests" Foreground="#cdd6f4" FontSize="13"
                          Margin="0,3" Checked="TestCheck_Changed" Unchecked="TestCheck_Changed" />
                <CheckBox x:Name="RunInstrumentCheck" Content="Run instrument tests" Foreground="#cdd6f4" FontSize="13"
                          Margin="0,3" Checked="TestCheck_Changed" Unchecked="TestCheck_Changed" />

                <StackPanel x:Name="FailurePanel" Margin="0,8,0,0">
                    <TextBlock Text="On test failure:" Foreground="#a6adc8" Margin="0,4" />
                    <ComboBox x:Name="FailureCombo" Style="{StaticResource DarkComboBox}">
                        <ComboBoxItem Content="Automatic bounce back (stop on failure)" />
                        <ComboBoxItem Content="Warning (notify and continue)" />
                        <ComboBoxItem Content="Warning + confirm to proceed" />
                        <ComboBoxItem Content="Silent (ignore failures)" />
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>